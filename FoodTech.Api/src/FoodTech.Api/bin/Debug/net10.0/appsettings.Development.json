{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "PostgreSql": {
    "ConnectionString": "Host=localhost;Port=5432;Database=foodtech;Username=foodtech_user;Password=foodtech_pass"
  },
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "foodtech_dev",
    "ClientCertificatePath": "",
    "ClientCertificatePassword": ""
  },
  "Jwt": {
    "Secret": "development-secret-key-change-in-production-minimum-32-characters-long",
    "Issuer": "foodtech-api-dev",
    "Audience": "foodtech-app-dev",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 30
  },
  "QR": {
    "SecretKey": "foodtech-qr-dev-secret-key"
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithProperty"],
    "Properties": {
      "Application": "FoodTech.Api"
    }
  }
}