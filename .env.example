# FoodTech .NET 10 Backend - Environment Variables
# Copy to .env and fill in your values
# DO NOT COMMIT .env FILE

# ============================================
# ASP.NET Core Configuration
# ============================================
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# ============================================
# MongoDB Connection (REQUIRED - Get from MongoDB Atlas)
# ============================================
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
ConnectionStrings__MongoDB=mongodb+srv://foodtech-user:YOUR_PASSWORD@cluster0.abc123.mongodb.net/foodtech?retryWrites=true&w=majority

# ============================================
# JWT Authentication (REQUIRED - Generate secure secrets)
# ============================================
# Generate: openssl rand -base64 48
JwtSettings__Secret=nQmOoK9zZAUfh62lI1EDFhOYsxuEnnKA0V/7dqe4xg7lfDockFlBxAPZ042Ltm/P

# Token issuer/audience (can keep defaults)
JwtSettings__Issuer=foodtech-api
JwtSettings__Audience=foodtech-app

# Access token expiry in minutes
JwtSettings__AccessTokenExpiryMinutes=60

# ============================================
# QR Code Signing (REQUIRED - Generate secure secret)
# ============================================
# Generate: openssl rand -base64 24
QR__SecretKey=Lezrslk1n3StNb+sx+/ac9WzYQxQR0c7

# ============================================
# Optional: CORS Frontend URL
# ============================================
# FRONTEND_URL=https://your-app.expo.dev

# ============================================
# Optional: Logging Level
# ============================================
# LOG_LEVEL=Information