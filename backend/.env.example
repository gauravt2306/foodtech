# Server
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# MongoDB (X.509)
MONGODB_URI=mongodb+srv://foodapp.enjrbrq.mongodb.net/?authSource=%24external&authMechanism=MONGODB-X509
MONGODB_DB=foodtech
MONGODB_TLS_CERT_FILE=./certs/client.pem
MONGODB_TLS_CA_FILE=./certs/ca.pem

# JWT (generate secure random strings for production)
JWT_SECRET=your_super_secure_random_64_char_string_here_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=another_super_secure_random_64_char_string_here_min_32_chars
JWT_REFRESH_EXPIRES_IN=30d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:8081

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880